{
  "entities": {
    "User": {
      "title": "User",
      "description": "Stores user profile and monetization status",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "corporate-admin", "corporate-user"] },
        "plan": { "type": "string", "enum": ["free", "premium"] },
        "expiryDate": { "type": "number" },
        "narrationsToday": { "type": "number" },
        "createdAt": { "type": "number" },
        "lastUsageDate": { "type": "string" },
        "isProfileComplete": { "type": "boolean" },
        "segment": { "type": "string" },
        "goal": { "type": "string" },
        "referral": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "PremiumCode": {
      "title": "PremiumCode",
      "description": "Redeemable codes for premium access",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "days": { "type": "number" },
        "isRedeemed": { "type": "boolean" },
        "redeemedAt": { "type": "number" },
        "redeemedBy": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["code", "days", "isRedeemed"]
    },
    "CorporatePlaylist": {
      "title": "CorporatePlaylist",
      "description": "Custom playlist shared within a corporate team",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "tracks": { 
          "type": "array",
          "items": { "$ref": "#/entities/CorporateTrack" }
        },
        "vignetteEnabled": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      }
    },
    "CorporateTrack": {
      "title": "CorporateTrack",
      "description": "Single track in a corporate playlist",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["file", "youtube", "spotify"] },
        "name": { "type": "string" },
        "src": { "type": "string" },
        "thumbnail": { "type": "string" }
      }
    },
    "CustomVoice": {
      "title": "CustomVoice",
      "description": "User-cloned voices",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "audioSampleBase64": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "SavedNarration": {
      "title": "SavedNarration",
      "description": "History of generated narrations for a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "voice": { "type": "string" },
        "audioBase64": { "type": "string" },
        "createdAt": { "type": "number" },
        "duration": { "type": "number" },
        "tone": { "type": "string" }
      },
      "required": ["userId", "text", "voice", "audioBase64", "createdAt"]
    },
    "UserSession": {
       "title": "UserSession",
       "description": "Tracks user session duration and tool usage",
       "type": "object",
       "properties": {
         "userId": { "type": "string" },
         "loginAt": { "type": "number" },
         "logoutAt": { "type": "number" },
         "duration": { "type": "number" },
         "toolsUsed": { 
           "type": "object",
           "description": "Map of tool IDs to duration spent in seconds"
         },
         "date": { "type": "string" }
       },
       "required": ["userId", "loginAt", "date"]
    },
    "UserFeedback": {
       "title": "UserFeedback",
       "description": "User ratings and highlighted evaluations",
       "type": "object",
       "properties": {
          "userId": { "type": "string" },
          "userName": { "type": "string" },
          "userEmail": { "type": "string" },
          "rating": { "type": "number" },
          "comment": { "type": "string" },
          "isHighlighted": { "type": "boolean" },
          "createdAt": { "type": "number" }
       },
       "required": ["userId", "rating", "createdAt"]
    },
    "SmartPlayPreferences": {
       "title": "SmartPlayPreferences",
       "description": "User configuration for SmartPlay Momento Informativo IA",
       "type": "object",
       "properties": {
          "userId": { "type": "string" },
          "selectedCategories": { "type": "array", "items": { "type": "string" } },
          "language": { "type": "string", "enum": ["pt", "en", "es"] },
          "scope": { "type": "string", "enum": ["global", "regional"] },
          "locutionStyle": { "type": "string" },
          "voiceId": { "type": "string" },
          "intervalType": { "type": "string", "enum": ["tracks", "minutes", "smart"] },
          "intervalValue": { "type": "number" },
          "duration": { "type": "number" },
          "blockedThemes": { "type": "array", "items": { "type": "string" } },
          "isPremiumEnabled": { "type": "boolean" },
          "updatedAt": { "type": "number" }
       },
       "required": ["userId", "selectedCategories", "language", "locutionStyle", "voiceId", "intervalType", "intervalValue", "duration"]
    },
    "NewsCache": {
       "title": "NewsCache",
       "description": "Cached news content by category",
       "type": "object",
       "properties": {
          "category": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "source": { "type": "string" },
          "language": { "type": "string" },
          "scope": { "type": "string" },
          "createdAt": { "type": "number" }
       },
       "required": ["category", "title", "summary", "createdAt"]
    },
    "ContentBlock": {
       "title": "ContentBlock",
       "description": "Generated scripts and audios ready to be played",
       "type": "object",
       "properties": {
          "category": { "type": "string" },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "audioBase64": { "type": "string" },
          "voice": { "type": "string" },
          "style": { "type": "string" },
          "language": { "type": "string" },
          "duration": { "type": "number" },
          "createdAt": { "type": "number" }
       },
       "required": ["category", "text", "audioBase64", "voice", "createdAt"]
    },
    "PlaybackHistory": {
       "title": "PlaybackHistory",
       "description": "Logs of listened, liked, skipped blocks",
       "type": "object",
       "properties": {
          "userId": { "type": "string" },
          "blockId": { "type": "string" },
          "category": { "type": "string" },
          "action": { "type": "string", "enum": ["play", "like", "dislike", "skip", "never_show_again"] },
          "playedAt": { "type": "number" },
          "durationPlayed": { "type": "number" }
       },
       "required": ["userId", "blockId", "action", "playedAt"]
    },
    "GeneratedNarration": {
       "title": "GeneratedNarration",
       "description": "Sub-table for narrations generated specifically",
       "type": "object",
       "properties": {
          "userId": { "type": "string" },
          "text": { "type": "string" },
          "voice": { "type": "string" },
          "audioBase64": { "type": "string" },
          "createdAt": { "type": "number" }
       },
       "required": ["userId", "text", "voice", "audioBase64", "createdAt"]
    },
    "PlaylistInsertion": {
       "title": "PlaylistInsertion",
       "description": "Queued smart blocks for specific users",
       "type": "object",
       "properties": {
          "userId": { "type": "string" },
          "blockId": { "type": "string" },
          "insertedAt": { "type": "number" },
          "played": { "type": "boolean" }
       },
       "required": ["userId", "blockId", "insertedAt", "played"]
    },
    "NewsSource": {
       "title": "NewsSource",
       "description": "Trusted news sites and feeds configuration",
       "type": "object",
       "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "category": { "type": "string" },
          "trusted": { "type": "boolean" }
       },
       "required": ["name", "url", "category"]
    },
    "SmartPlayCategory": {
       "title": "SmartPlayCategory",
       "description": "Configuration list of available smart categories",
       "type": "object",
       "properties": {
          "name": { "type": "string" },
          "icon": { "type": "string" }
       },
       "required": ["name"]
    },
    "VoiceProfile": {
       "title": "VoiceProfile",
       "description": "Standard voice options properties",
       "type": "object",
       "properties": {
          "name": { "type": "string" },
          "gender": { "type": "string" },
          "tone": { "type": "string" }
       },
       "required": ["name"]
    },
    "ContentHistory": {
       "title": "ContentHistory",
       "description": "Traceability log of played information items to avoid repeats",
       "type": "object",
       "properties": {
          "userId": { "type": "string" },
          "contentId": { "type": "string" },
          "playedAt": { "type": "number" }
       },
       "required": ["userId", "contentId", "playedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user settings"
    },
    "/premiumCodes/{codeId}": {
      "schema": "PremiumCode",
      "description": "System-wide premium activation codes"
    },
    "/corporateContent/{adminId}": {
      "schema": "CorporatePlaylist",
      "description": "Shared playlist and settings for a corporate team"
    },
    "/customVoices/{voiceId}": {
      "schema": "CustomVoice",
      "description": "Cloned voices for individual users"
    },
    "/narrations/{narrationId}": {
      "schema": "SavedNarration",
      "description": "History of generated narrations"
    },
    "/sessions/{sessionId}": {
       "schema": "UserSession",
       "description": "User engagement metrics"
    },
    "/feedbacks/{feedbackId}": {
       "schema": "UserFeedback",
       "description": "User reviews and highlights"
    },
    "/userPreferences/{userId}": {
       "schema": "SmartPlayPreferences",
       "description": "SmartPlay Preferences"
    },
    "/newsCache/{cacheId}": {
       "schema": "NewsCache",
       "description": "Recent news cache"
    },
    "/contentBlocks/{blockId}": {
       "schema": "ContentBlock",
       "description": "Generated speech news clips"
    },
    "/playbackHistory/{historyId}": {
       "schema": "PlaybackHistory",
       "description": "Logs of user smart play interactions"
    },
    "/generatedNarrations/{narrationId}": {
       "schema": "GeneratedNarration",
       "description": "Log of specific narration outputs"
    },
    "/playlistInsertions/{insertionId}": {
       "schema": "PlaylistInsertion",
       "description": "Queue insertions logs"
    },
    "/newsSources/{sourceId}": {
       "schema": "NewsSource",
       "description": "Sources list metadata"
    },
    "/categories/{categoryId}": {
       "schema": "SmartPlayCategory",
       "description": "System categories lists"
    },
    "/voiceProfiles/{profileId}": {
       "schema": "VoiceProfile",
       "description": "Available voice profiles"
    },
    "/contentHistory/{historyId}": {
       "schema": "ContentHistory",
       "description": "History logs of content elements"
    }
  }
}
