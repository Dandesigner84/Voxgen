rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // --- Collection Rules ---

    match /admins/{userId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /premiumCodes/{codeId} {
      allow read, write: if true;
    }

    match /corporateContent/{adminId} {
      allow read, write: if true;
    }

    match /customVoices/{voiceId} {
      allow read, write: if true;
    }

    match /narrations/{narrationId} {
      allow read, write: if true;
    }

    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    match /userPreferences/{userId} {
      allow read, write: if true;
    }

    match /newsCache/{cacheId} {
      allow read, write: if true;
    }

    match /contentBlocks/{blockId} {
      allow read, write: if true;
    }

    match /playbackHistory/{historyId} {
      allow read, write: if true;
    }

    match /generatedNarrations/{narrationId} {
      allow read, write: if true;
    }

    match /playlistInsertions/{insertionId} {
      allow read, write: if true;
    }

    match /newsSources/{sourceId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /voiceProfiles/{profileId} {
      allow read, write: if true;
    }

    match /contentHistory/{historyId} {
      allow read, write: if true;
    }

    match /bulletinBgMusic/{itemId} {
      allow read, write: if true;
    }

    match /bulletinHistory/{itemId} {
      allow read, write: if true;
    }

    match /bulletinUsage/{usageId} {
      allow read, write: if true;
    }

    match /bulletinConfigs/{userId} {
      allow read, write: if true;
    }

    match /dialogueHistory/{historyId} {
      allow read, write: if true;
    }
  }
}

